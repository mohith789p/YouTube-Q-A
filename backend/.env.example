# Application Settings
APP_NAME="YouTube RAG Backend API"
VERSION="1.0.0"
DESCRIPTION="Backend service for YouTube video transcript processing and RAG chat."

# Google Gemini API Key (Get your key from https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here

# AI & Embedding Model Configurations
EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_MODEL="gemini-2.5-flash"

# Vector Database Storage Location
CHROMA_PERSIST_DIR="./database/chroma_db"

# CORS Configuration (Allowed origins list for frontend integration)
ALLOWED_ORIGINS='["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]'
